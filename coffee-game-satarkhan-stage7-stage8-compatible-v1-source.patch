+import { getTournamentStatusLabel } from "@/lib/tournament-definition";
+
+type Participant = {
+  key: string;
+  name: string;
+  seed: number | null;
+};
+
+type Standing = {
+  rank: number;
+  participant: Participant;
+  played: number;
