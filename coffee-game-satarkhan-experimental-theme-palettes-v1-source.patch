+      .then(({ response, payload }) => {
+        if (!response.ok) return setError(payload.message || "دریافت تنظیمات انجام نشد.");
+        const item = payload.item as Settings;
+        savedAppearance.current = item.appearance;
+        setSettings(item);
+        applyPalette(activePalette(item.appearance), true);
+      })
+      .catch(() => setError("دریافت تنظیمات انجام نشد."));
+
+    return () => {
+      if (savedAppearance.current) applyPalette(activePalette(savedAppearance.current), true);
+    };
+  }, []);
+
+  function updateAppearance(appearance: AppearanceSettings) {
