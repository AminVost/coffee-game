@@ -0,0 +1,51 @@
+export const DEFAULT_THEME_PALETTE = "indigo-violet" as const;
+export const THEME_PALETTE_STORAGE_KEY = "coffee-game-theme-palette-v1";
+
+export const THEME_PALETTES = [
+  {
+    id: "indigo-violet",
+    label: "آبی ارغوانی",
+    description: "متعادل، مدرن و قابل اعتماد",
+    swatches: ["#4f46e5", "#6366f1", "#8b5cf6", "#c4b5fd"]
+  },
+  {
+    id: "ocean-cyan",
+    label: "اقیانوسی",
+    description: "آرام، شفاف و تکنولوژیک",
+    swatches: ["#0369a1", "#0284c7", "#06b6d4", "#67e8f9"]
+  },
+  {
+    id: "royal-purple",
+    label: "بنفش خلاق",
+    description: "خلاق، پرانرژی و متفاوت",
+    swatches: ["#6d28d9", "#7c3aed", "#db2777", "#f0abfc"]
+  },
+  {
+    id: "sunset-coral",
+    label: "غروب گرم",
+    description: "صمیمی، فعال و دعوت‌کننده",
+    swatches: ["#c2410c", "#ea580c", "#f59e0b", "#fdba74"]
+  },
+  {
+    id: "graphite-gold",
+    label: "گرافیتی طلایی",
+    description: "جدی، مینیمال و لوکس",
+    swatches: ["#1e293b", "#475569", "#d4a017", "#f5d76e"]
+  },
+  {
+    id: "emerald-gold",
+    label: "زمردی کلاسیک",
+    description: "آشنا، پویا و ورزشی",
+    swatches: ["#087a43", "#0f9f5c", "#ca941c", "#efbd45"]
+  }
+] as const;
+
+export type ThemePaletteId = (typeof THEME_PALETTES)[number]["id"];
+
+export function isThemePaletteId(value: unknown): value is ThemePaletteId {
+  return THEME_PALETTES.some((palette) => palette.id === value);
+}
+
+export function normalizeThemePalette(value: unknown): ThemePaletteId {
+  return isThemePaletteId(value) ? value : DEFAULT_THEME_PALETTE;
+}
diff --git a/src/lib/theme-settings.ts b/src/lib/theme-settings.ts
new file mode 100644
index 0000000..f22512d
--- /dev/null
+++ b/src/lib/theme-settings.ts
@@ -0,0 +1,47 @@
+import { unstable_cache } from "next/cache";
+import type { RowDataPacket } from "mysql2";
+import { queryRows } from "@/lib/db";
+import { DEFAULT_THEME_PALETTE, normalizeThemePalette, type ThemePaletteId } from "@/lib/theme-palettes";
+
+export type AppearanceSettings = {
+  experimentalEnabled: boolean;
+  palette: ThemePaletteId;
+};
+
+type SettingRow = RowDataPacket & { value: unknown };
+
+export const DEFAULT_APPEARANCE_SETTINGS: AppearanceSettings = {
+  experimentalEnabled: false,
+  palette: DEFAULT_THEME_PALETTE
+};
+
+function parse(value: unknown): Record<string, unknown> {
+  try {
+    if (typeof value === "string") return JSON.parse(value) as Record<string, unknown>;
+    return value && typeof value === "object" ? value as Record<string, unknown> : {};
+  } catch {
+    return {};
+  }
+}
+
+async function loadAppearanceSettings(): Promise<AppearanceSettings> {
+  const rows = await queryRows<SettingRow[]>(
+    "SELECT value FROM app_settings WHERE `key`='appearance.settings' LIMIT 1"
+  );
+  const stored = parse(rows[0]?.value);
+  return {
+    experimentalEnabled: stored.experimentalEnabled === true,
+    palette: normalizeThemePalette(stored.palette)
+  };
+}
+
+export const getAppearanceSettings = unstable_cache(
+  loadAppearanceSettings,
+  ["appearance-settings-v1"],
+  { revalidate: 300, tags: ["appearance-theme"] }
+);
+
+export async function getActiveThemePalette() {
+  const settings = await getAppearanceSettings();
+  return settings.experimentalEnabled ? settings.palette : DEFAULT_THEME_PALETTE;
+}
