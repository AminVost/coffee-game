+        JSON.stringify(input.notificationSettings),
+        JSON.stringify(input.cancellationSettings),
+        JSON.stringify(input.prizeSettings),
+        input.coverImageUrl || null,
+        input.isFeatured ? 1 : 0,
+        input.status,
+        id
+      ]);
